# ============================================================================
# MADEIT ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# ---------------------------------------------------------------------------
# Supabase (Database + Authentication)
# ---------------------------------------------------------------------------
# Get these from: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Email (Gmail SMTP via Nodemailer)
# ---------------------------------------------------------------------------
# Used by server-side API functions to send transactional emails.
# Create a Gmail App Password: https://support.google.com/accounts/answer/185833
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ---------------------------------------------------------------------------
# Cloudinary (File Uploads)
# ---------------------------------------------------------------------------
# Used for uploading milestone proof files (images, videos, documents).
# Get these from: https://cloudinary.com → Dashboard / Settings → Upload
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# ---------------------------------------------------------------------------
# App Configuration (Optional)
# ---------------------------------------------------------------------------
VITE_APP_URL=https://your-app-domain.vercel.app
VITE_ADMIN_EMAIL=admin@your-domain.com
VITE_EMAIL=support@your-domain.com
ADMIN_EMAIL=admin@your-domain.com
